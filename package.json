{
  "name": "variables-to-css-and-tailwind",
  "version": "1.0.0",
  "private": true,
  "description": "Figma plugin that exports local variables as CSS custom properties and a Tailwind theme.",
  "main": "code.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run build:code && npm run build:ui",
    "build:code": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "lint": "eslint --ext .ts,.tsx,.js --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern code.js .",
    "lint:fix": "eslint --ext .ts,.tsx,.js --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern code.js --fix .",
    "watch": "npm run build:code -- --watch",
    "test": "npm run build:code && node tests/plugin.test.js"
  },
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "^0.16.1",
    "@figma/plugin-typings": "^1.116.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "ui/**/*.js"
        ],
        "env": {
          "browser": true,
          "es2022": true
        },
        "parserOptions": {
          "project": null,
          "ecmaVersion": "latest",
          "sourceType": "module"
        }
      },
      {
        "files": [
          "tests/**/*.js"
        ],
        "env": {
          "node": true,
          "es2022": true
        },
        "parserOptions": {
          "project": null,
          "ecmaVersion": "latest",
          "sourceType": "script"
        },
        "rules": {
          "@typescript-eslint/no-var-requires": "off"
        }
      }
    ]
  },
  "dependencies": {
    "@rogieking/figui3": "11.1.6"
  }
}
